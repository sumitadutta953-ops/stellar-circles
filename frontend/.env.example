# Stellar Circles — Frontend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Soroban Contract IDs (Stellar Testnet) ─────────────────────────────────
# Run scripts/deploy.ps1 to deploy contracts and auto-populate these values.
VITE_CIRCLE_FACTORY_ID=
VITE_CONTRIBUTION_ID=
VITE_PAYOUT_ID=
VITE_PASSKEY_FACTORY_ID=
VITE_REPUTATION_ID=
VITE_DEFAULT_HANDLER_ID=

# ── Firebase (Firestore off-chain metadata) ────────────────────────────────
# Create a Firebase project at https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── PostHog Product Analytics (optional) ──────────────────────────────────
# Get your key at https://app.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Sentry Error Monitoring (optional) ────────────────────────────────────
# Get your DSN at https://sentry.io
VITE_SENTRY_DSN=
